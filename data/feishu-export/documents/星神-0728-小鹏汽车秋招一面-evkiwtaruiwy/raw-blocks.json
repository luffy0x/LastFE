  {
    "block_id": "R8IldEdtIoDaU4xg2Prcn7QknzD",
    "block_type": 2,
    "parent_id": "AoBOdNZVaoKNykxBmGzc8iBfnOh",
    "text": {
      "elements": [
        {
          "text_run": {
            "content": "题目：搜索框防抖，比如用户先输入 apple ，在防抖时间内又继续输入为 AppleWatch，只会处理一次。另外，需处理搜索 AppleWatch 先返回但 apple 后返回的情况——旧请求不能覆盖新请求结果。",
            "text_element_style": {
              "bold": false,
              "inline_code": false,
              "italic": false,
              "strikethrough": false,
              "underline": false
            }
          }
        }
      ],
      "style": {
        "align": 1,
        "folded": false
      }
    }
  },
  {
    "block_id": "BHoSd1CaqoogHAxGx1bcxlUAnyg",
    "block_type": 14,
    "code": {
      "elements": [
        {
          "text_run": {
            "content": "import React from 'react';\n\nfunction SearchProduct() {\n  const [keyword, setKeyword] = useState('');\n\n  // 入参：keyword（搜索关键词），searchProduct（异步搜索函数），300（防抖时间）\n  const { data, loading, error } = useDebounceSearch(keyword, searchProduct, 300);\n\n  const handleInputChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    setKeyword(e.target.value);\n  };\n\n  return (\n    <div>\n      <input\n        type=\"text\"\n        value={keyword}\n        onChange={handleInputChange}\n        placeholder=\"搜索商品...\"\n      />\n      {loading && <div>加载中...</div>}\n      {error && <div>出错了：{error.message}</div>}\n      {data && <div>搜索结果：{JSON.stringify(data)}</div>}\n    </div>\n  );\n}\n\n// 模拟的异步搜索函数\nasync function searchProduct(keyword: string) {\n  const response = await fetch(`/api/products?q=${keyword}`);\n  return response.json();\n",
            "text_element_style": {
              "bold": false,
              "inline_code": false,
              "italic": false,
              "strikethrough": false,
              "underline": false
            }
          }
        },
        {
          "text_run": {
            "content": "}",
            "text_element_style": {
              "bold": false,
