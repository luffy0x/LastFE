  {
    "block_id": "YPsMd7szeoxvSux0URicy1iOnPe",
    "block_type": 14,
    "code": {
      "elements": [
        {
          "text_run": {
            "content": "function useDebounceSearch() {\n  \n",
            "text_element_style": {
              "bold": false,
              "inline_code": false,
              "italic": false,
              "strikethrough": false,
              "underline": false
            }
          }
        },
        {
