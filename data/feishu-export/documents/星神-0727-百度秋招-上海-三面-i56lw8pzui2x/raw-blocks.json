  {
    "block_id": "O2BKd0tzCoevb8xyb8KcEUQ6nUg",
    "block_type": 14,
    "code": {
      "elements": [
        {
          "text_run": {
            "content": "// 思路：找到数组中间的节点作为当前处理节点，然后使用递归进行左右节点处理\n/*\n[1, 2, 3, 4, 5, 6, 7]\n         ↑\n\n          4\n[1, 2, 3]   [5, 6, 7]\n   ↑           ↑\n\n    2           6\n[1]  [3]    [5]   [7]\n*/\n\nclass treeNode {\n    val: number;\n    left: treeNode | null;\n    right: treeNode | null;\n\n    constructor(val: number) {\n        this.val = val;\n        this.left = null;\n        this.right = null;\n    }\n}\n\nfunction sortedArrayToBST(arr: number[]): treeNode | null {\n    if (arr.length === 0) return null;\n\n    const mid = Math.floor(arr.length / 2);\n    const root = new treeNode(arr[mid]);\n    root.left = sortedArrayToBST(arr.slice(0, mid));\n    root.right = sortedArrayToBST(arr.slice(mid + 1));\n    return root;\n",
            "text_element_style": {
              "bold": false,
              "inline_code": false,
              "italic": false,
              "strikethrough": false,
              "underline": false
            }
          }
        },
        {
          "text_run": {
            "content": "}",
            "text_element_style": {
              "bold": false,
              "inline_code": false,
              "italic": false,
              "strikethrough": false,
              "underline": false
            }
          }
        }
      ],
      "style": {
        "language": 63,
        "wrap": false
      }
    },
