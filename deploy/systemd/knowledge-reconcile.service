[Unit]
Description=Reconcile Knowledge Frontier GitHub submissions
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/srv/knowledge-frontier/current
UMask=0077
Environment=APP_ENV_FILE=/etc/knowledge-frontier/app.env
TimeoutStartSec=34min
ExecStart=/usr/bin/flock -w 1020 -E 75 /run/lock/knowledge-frontier-maintenance.lock /usr/bin/timeout --foreground --kill-after=30s 15m /usr/bin/docker compose --profile maintenance run --rm maintenance pnpm reconcile:github
